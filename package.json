{
  "name": "golden-paw",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Windows / macOS 咕咕嘎嘎定时动画提醒",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "npm run build:cinema && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/desktop/main.cjs && node --check src/desktop/preload.cjs && node --check src/renderer/app.js && node --check src/renderer/reminder-cinema.mjs && node --check src/core/reminders.cjs",
    "package:mac": "npm run build:cinema && electron-builder --mac dir",
    "build:cinema": "esbuild src/renderer/reminder-cinema.mjs --bundle --minify --format=iife --outfile=src/renderer/generated/reminder-cinema.js",
    "package:win": "npm run build:cinema && electron-builder --win nsis --x64",
    "package:win:dir": "npm run build:cinema && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.zoey.goldenpaw",
    "productName": "Golden Paw",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/desktop/icons/gugu.ico",
      "artifactName": "Gugu-Reminder-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "咕咕提醒",
      "runAfterFinish": true
    }
  }
}
